# Store / Catalog API (Spring Boot)
CATALOG_API_URL=http://localhost:8082/api
STORE_API_URL=http://localhost:8082/api
# Production: set ALLOW_CATALOG_FALLBACK=true only if demo fallback is intentional
# ALLOW_CATALOG_FALLBACK=false
# ADMIN_API_KEY must match store-backend app.admin.api-key (BFF token mint)
ADMIN_API_KEY=dev-admin-key

# Single database: Postgres (same store DB as store-backend)
# Prefer DATABASE_URL, or match Spring DB_* defaults
DATABASE_URL=postgresql://store_user:your_secure_password@localhost:5432/store
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=store
# DB_USERNAME=store_user
# DB_PASSWORD=your_secure_password

# Authentication
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# CSRF Protection
CSRF_SECRET=your-csrf-secret-key-change-in-production

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_APP_SECRET=your-paypal-client-secret
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Stripe (Payment Element + refunds on support cancel)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe CLI / Dashboard webhook endpoint → /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal webhook (Dashboard) → /api/webhooks/paypal ; subscribe to PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
# From address must be verified in Resend (see lib/constants SENDER_EMAIL)

# Product image uploads (optional S3-compatible object storage)
# When unset, seller uploads go to public/uploads/products/ (local/dev).
# Works with AWS S3, Cloudflare R2, MinIO, etc.
# S3_BUCKET=my-product-images
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional custom endpoint (R2/MinIO):
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# Public URL prefix for objects (CDN or bucket website); also added to next/image remotePatterns:
# S3_PUBLIC_BASE_URL=https://images.example.com
# Optional key prefix (default: products)
# S3_KEY_PREFIX=products

# App Configuration
NEXT_PUBLIC_APP_NAME=Commerce Store
NEXT_PUBLIC_APP_DESCRIPTION=A general commercial storefront with smart filters
NEXT_PUBLIC_APP_SLOGAN=Everything you need, one store
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
